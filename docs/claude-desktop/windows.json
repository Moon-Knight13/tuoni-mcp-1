{
  "mcpServers": {
    "tuoni": {
      "command": "C:/Users/YOU/.local/bin/uv.exe",
      "args": [
        "--directory",
        "C:/Users/YOU/src/tuoni-mcp",
        "run",
        "--frozen",
        "--no-dev",
        "--env-file",
        "C:/Users/YOU/AppData/Local/Tuoni/tuoni.env",
        "tuoni-mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "TUONI_MCP_PROFILES": "agent-ops",
        "TUONI_MCP_MODE": "native",
        "TUONI_MCP_READ_ONLY": "false",
        "TUONI_MCP_TOOL_PREFIX": ""
      }
    }
  }
}
