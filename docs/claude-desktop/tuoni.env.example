# Copy outside the repository, edit, and set its absolute path after --env-file.
TUONI_URL=https://your-tuoni-server:8443
TUONI_USERNAME=operator
TUONI_PASSWORD='replace-with-your-password'
# Skip certificate checks for self-signed lab servers.
TUONI_VERIFY_TLS=false
# To verify certificates, use true or an absolute CA-bundle path.
