# Copy to override.env and fill in. override.env is git-ignored.
# Required:
TUONI_URL=https://localhost:8443
TUONI_USERNAME=operator
TUONI_PASSWORD=replace-with-your-tuoni-password
# Skip certificate checks for self-signed lab servers.
TUONI_VERIFY_TLS=false

# Optional overrides:
# To verify certificates, set TUONI_VERIFY_TLS=true or a CA-bundle path.
# TUONI_REQUEST_TIMEOUT=30
# TUONI_MCP_RESPONSE_MAX_BYTES=16777216
# TUONI_MCP_PROFILES=agent-ops
# TUONI_MCP_MODE=native
# TUONI_MCP_READ_ONLY=true
# To save command-result file parts for local inspection, enable artifacts,
# bind-mount this absolute path into the container at the same path, and set:
# TUONI_MCP_PROFILES=agent-ops,artifacts
# TUONI_MCP_DOWNLOAD_DIR=/absolute/path/to/tuoni-result-downloads
# TUONI_MCP_DOWNLOAD_MAX_BYTES=134217728
# TUONI_MCP_UPLOAD_DIR=/absolute/path/to/existing-artifact-staging
# TUONI_MCP_UPLOAD_MAX_BYTES=16777216
# Enable bounded event polling by adding the profile, for example:
# TUONI_MCP_PROFILES=agent-ops,events
