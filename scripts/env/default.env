# Defaults baked into the image / compose. Non-secret only.
# Real credentials go in scripts/env/override.env (git-ignored).

TUONI_MCP_IMAGE=shelldot/tuoni-mcp:latest

TUONI_VERIFY_TLS=true

# Application settings defaults. Profiles are additive and
# startup-static. The default agent-ops catalog has eleven tools, seven read-only.
# tuoni_capabilities reports effective settings without contacting the backend.
# Run `tuoni-mcp doctor` for backend checks, or add --offline for configuration only.
TUONI_MCP_PROFILES=agent-ops
TUONI_MCP_MODE=native
TUONI_MCP_READ_ONLY=false

# Events are off unless the events profile is selected.
TUONI_MCP_EVENT_BUFFER=200
